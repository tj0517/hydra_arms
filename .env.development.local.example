# Local Supabase development environment — copy to .env.development.local
#
# Start the stack:  npm run db:start   (slimmed, no Studio/imgproxy/mailpit/etc.)
# Reset the DB:     npm run db:reset
# Run shop tests:   npm run test:shop:local
#
# Supabase URL and keys below are LOCAL DEFAULTS — not secrets.
# Get the actual values after `npm run db:start`:  supabase status
# They change only if you regenerate keys with `supabase gen keys local`.
# Do NOT copy real prod/staging secrets into this file.

# ─── Supabase — local stack ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Paste the anon key from `supabase status`:
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from: supabase status>
# Paste the service_role key from `supabase status`:
SUPABASE_SERVICE_ROLE_KEY=<service_role key from: supabase status>

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Leave blank — app degrades gracefully with hardcoded defaults
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─── BaseLinker ───────────────────────────────────────────────────────────────
BASELINKER_MOCK=true               # Always true locally — no real BL calls
BASELINKER_TOKEN=
BASELINKER_INVENTORY_ID=35743
BASELINKER_PRICE_GROUP=
BASELINKER_PRICE_GROUP_PURCHASE=
BASELINKER_WAREHOUSE_H1=
BASELINKER_WAREHOUSE_H2=
BASELINKER_WAREHOUSE_H3=
BASELINKER_MARKUP_KOLBA=
BASELINKER_MARKUP_SHARG=
BASELINKER_MARKUP_SPECHURT=
BASELINKER_ORDER_SOURCE_ID=
BASELINKER_STATUS_PAID=
BASELINKER_STATUS_PROCESSING=
BASELINKER_STATUS_SHIPPED=
BASELINKER_STATUS_DELIVERED=
BASELINKER_STATUS_CANCELLED=
BASELINKER_STATUS_RETURN=

# ─── External services — leave blank locally ─────────────────────────────────
# No mail goes out (Resend key empty), no P24 charges (never connected locally)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUDIENCE_AKTUALNOSCI=
RESEND_AUDIENCE_B2G=
RESEND_AUDIENCE_B2B=
EMAIL_RD=
EMAIL_B2G=
EMAIL_HANDEL=
EMAIL_BIURO=

P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=mock-crc-key-dev      # test key — any value works in mock mode
P24_API_KEY=
P24_MODE=mock                     # mock | sandbox | production

# ─── Hurtownie ────────────────────────────────────────────────────────────────
SPECHURT_KEY=
SHARG_CLIENT=
SHARG_TOKEN_FULL=
SHARG_TOKEN_LIGHT=
SHARG_TOKEN_GATEWAY=

# ─── Shop ─────────────────────────────────────────────────────────────────────
SYNC_SECRET=local-sync-secret-dev
CRON_SECRET=local-cron-secret-dev
XML_SYNC_ENABLED=false
