# ─── Sanity CMS ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── BaseLinker — połączenie ──────────────────────────────────────────────────
BASELINKER_TOKEN=
BASELINKER_MOCK=false

# Katalog i magazyn
BASELINKER_INVENTORY_ID=          # ID katalogu w BL (Produkty → Ustawienia → Katalogi)
BASELINKER_PRICE_GROUP=           # ID grupy cenowej "Cena sprzedaży" (Produkty → Ustawienia → Grupy cenowe)
BASELINKER_PRICE_GROUP_PURCHASE=  # ID grupy cenowej "Cena zakupu"
BASELINKER_WAREHOUSE_H1=          # ID magazynu H1 = Kolba, format: bl_XXXXXX (Produkty → Ustawienia → Magazyny)
BASELINKER_WAREHOUSE_H2=          # ID magazynu H2 = Sharg
BASELINKER_WAREHOUSE_H3=          # ID magazynu H3 = Spechurt

# Marża per hurtownia (procent od ceny zakupu; 25 = cena zakupu +25%)
# Używane przez scripts/xml-to-baselinker.ts — cena sprzedaży NIGDY nie idzie z feedu
BASELINKER_MARKUP_KOLBA=
BASELINKER_MARKUP_SHARG=
BASELINKER_MARKUP_SPECHURT=

# Zamówienia — źródło
BASELINKER_ORDER_SOURCE_ID=       # ID źródła "Sklep internetowy" (Zamówienia → Ustawienia → Źródła zamówień)

# Zamówienia — statusy (Zamówienia → Ustawienia → Statusy zamówień)
# Skopiuj ID każdego statusu z BL
BASELINKER_STATUS_PAID=           # "Opłacone"       — checkout pushuje zamówienia do BL z tym statusem (puste = push pomijany!)
BASELINKER_STATUS_PROCESSING=     # "W realizacji"   — magazyn pakuje
BASELINKER_STATUS_SHIPPED=        # "Wysłane"        — paczka nadana, jest tracking
BASELINKER_STATUS_DELIVERED=      # "Dostarczone"    — kurier dostarczył
BASELINKER_STATUS_CANCELLED=      # "Anulowane"
BASELINKER_STATUS_RETURN=         # "Zwrot"

# ─── Hurtownie (feedy XML) — sekrety pobierania ───────────────────────────────
SPECHURT_KEY=                     # klucz z linku eksportu HEAVY Spechurtu
SHARG_CLIENT=office@hydra-arms.com
SHARG_TOKEN_FULL=                 # token feedu Sharg type=full
SHARG_TOKEN_LIGHT=                # token feedu Sharg type=light
SHARG_TOKEN_GATEWAY=              # token feedu Sharg type=gateway
# Kolba: URL publiczny, bez sekretu — na stałe w kodzie

# ─── Przelewy24 ───────────────────────────────────────────────────────────────
P24_MERCHANT_ID=                  # ID sprzedawcy z panelu Przelewy24
P24_POS_ID=                       # POS ID (zazwyczaj = MERCHANT_ID)
P24_CRC_KEY=                      # Klucz CRC do weryfikacji podpisów
P24_API_KEY=                      # Klucz API (do tworzenia transakcji)
P24_SANDBOX=true                  # true = środowisko testowe, false = produkcja

# ─── Shop ─────────────────────────────────────────────────────────────────────
SYNC_SECRET=                      # Dowolny losowy string — chroni POST /api/shop/sync (trigger ręczny/VPS)
CRON_SECRET=                      # Losowy string — Vercel wysyła go jako "Authorization: Bearer" przy cronach (GET /api/shop/sync, /api/shop/orders/sync)
XML_SYNC_ENABLED=false            # Legacy: bezpośredni import XML→Supabase (POST /api/xml/sync). BL jest źródłem prawdy — zostaw false

# ─── Resend (email + newsletter) ──────────────────────────────────────────────
RESEND_API_KEY=                   # re_xxxx — klucz API z resend.com/api-keys
RESEND_FROM_EMAIL=                # np. formularz@hydra-arms.com (zweryfikowana domena w Resend)

# Audiences (3 listy — limit planu free)
# aktualnosci + blog → AKTUALNOSCI, b2g → B2G, b2b + sklep → B2B
RESEND_AUDIENCE_AKTUALNOSCI=      # UUID z resend.com/audiences
RESEND_AUDIENCE_B2G=              # UUID z resend.com/audiences
RESEND_AUDIENCE_B2B=              # UUID z resend.com/audiences

# Opcjonalne nadpisania adresów email działów (domyślnie: office@hydra-arms.com)
EMAIL_RD=
EMAIL_B2G=
EMAIL_HANDEL=
EMAIL_BIURO=
